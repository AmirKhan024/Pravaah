# Groq — wording, translation and what-if parsing ONLY. Never numbers.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Supabase — The Room + Black Box (Phase 2). Both NEXT_PUBLIC_* (browser, Realtime SELECT-only via
# RLS) and the non-prefixed pair (server-only, service-role, bypasses RLS) must be set together.
# Missing any of these -> falls back to the original in-memory behavior automatically.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Only needed to run scripts/apply-schema.mjs (see supabase/schema.sql); the app itself never
# opens a raw Postgres connection.
DIRECT_URL=

# Telegram ops channel (Phase 3) — staff/transport/accommodation orders only, never crowd messages.
# TELEGRAM_OPS_CHAT_ID: message the bot once, then run `node scripts/telegram-whoami.mjs`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=

# 1 = no network calls (Groq/Supabase/Telegram/Twilio); everything falls back to local behavior
NEXT_PUBLIC_DEMO_OFFLINE=0

# optional real delivery (SMS) for the orders screen
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
